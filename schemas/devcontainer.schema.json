{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "The supported subset of Dev Container configuration used by this repository, not the complete upstream specification.",
  "properties": {
    "$schema": { "type": "string" },
    "build": {
      "type": "object",
      "required": ["dockerfile", "context", "args"],
      "properties": {
        "dockerfile": { "const": "Dockerfile" },
        "context": { "const": ".." },
        "args": {
          "type": "object",
          "required": ["USER"],
          "properties": {
            "USER": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "customizations": { "type": "object" },
    "features": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "patternProperties": {
        "^ghcr\\.io/devcontainers/features/docker-in-docker:[0-9]+\\.[0-9]+\\.[0-9]+$": {
          "type": "object",
          "required": [
            "version",
            "mobyBuildxVersion",
            "dockerDashComposeVersion",
            "moby",
            "installDockerBuildx",
            "installDockerComposeSwitch"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "mobyBuildxVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "dockerDashComposeVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "moby": { "const": true },
            "installDockerBuildx": { "const": false },
            "installDockerComposeSwitch": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "init": { "const": true },
    "mounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^/" },
          "type": { "const": "volume" }
        },
        "additionalProperties": false
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "postCreateCommand": { "type": "string", "minLength": 1 },
    "postStartCommand": { "type": "string", "minLength": 1 },
    "remoteEnv": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "remoteUser": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*$",
      "not": { "const": "root" }
    },
    "shutdownAction": { "const": "stopContainer" },
    "updateRemoteUserUID": { "const": true },
    "waitFor": { "enum": ["postCreateCommand", "postStartCommand"] }
  },
  "required": [
    "build",
    "features",
    "init",
    "mounts",
    "remoteUser",
    "postCreateCommand",
    "postStartCommand"
  ],
  "title": "Repository Dev Container contract",
  "type": "object"
}
