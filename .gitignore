# --------------------------------------------------
# Allowlist git ignore file.
#
# Ignore files by default, then allow repository inputs with ! exceptions.
# Allowed directories can use their own .gitignore files to exclude generated
# files. projects/ and the Node and Python script folders use this approach.
# Existing tracked files are not affected by ignore rules.
#
# A leading / anchors a pattern to the directory containing this file.
# A trailing / matches directories only. Patterns without a leading or middle
# slash match names at any depth below this file. The last matching rule wins
# within a file, while a nested .gitignore takes precedence for its subtree.
#
# Allow one file:                    !/path/to/file
# Allow directory traversal only:   !/path/to/directory/
# Allow a directory's descendants:  !/path/to/directory/**
# Allow a root-level file type:     !/*.json
#
# !*/ keeps parent directories traversable so nested exceptions can work.
# Ignored files can still be force-added. Tools may also use these rules for
# discovery, but this file is not a security boundary.
#
# For more information, see:
# https://git-scm.com/docs/gitignore
# --------------------------------------------------

# Deny by default
*

# Allow directory traversal
!*/

# Rely on the project-level .gitignore for project files
!/projects/**

# Allow specific root-level directories
!/.devcontainer/**
!/.husky/**
!/.vscode/**
!/scripts/**
!/docs/**
!/policy/**
!/.github/**
!/schemas/**
!/licenses/**
!/spellcheck/*

# Allow specific root-level file types
!/*.json
!/*.jsonc
!/*.toml
!/*.yaml
!/*.yml
!/*.lock
!/*.*ignore
!/*.md
!/*.config.js
!/*.code-workspace

# Allow specific root-level files
!/.editorconfig
!/.env.template
!/.git-blame-ignore-revs
!/.gitattributes
!/.gitmessage
!/.gitmodules
!/.mailmap
!/.npmrc
!/.shellcheckrc
!/AUTHORS
!/LICENSE

# Generated content
# Put reproducible outputs in .generated and tool caches in .cache/<tool>.
# Existing scripts do not justify an exception to this layout.
# Generated files remain ignored by the deny-by-default rule above.
# Allow only reviewed, stable artifacts that need to ship with the repository.
# Parent directories remain traversable through !*/ above.
# Examples of selective exceptions, not active blanket permissions
# !/.generated/schemas/*.json
# !/.generated/docs/**/*.md
# Never commit tool caches, including caches below allowed source folders
**/.cache/

# Temporary migration backups are not monorepo inputs
/.local-work/

# Tool-managed native dependency graphs belong beside the discovered mise lock
# These are reproducibility inputs, not disposable caches or build reports
!/.mise/
!/.mise/aqua.yaml
!/.mise/locks/
!/.mise/locks/**

# Private recovery journals are local state, never source or build inputs
/.devcontainer/.mise-bootstrap-update/
/.devcontainer/.mise-bootstrap-update.lock
/.devcontainer/.mise-bootstrap-update.preparing-*/
# TODO: Allow other root-level files as needed

# Keep runtime dependencies and Python caches excluded in every allowed subtree
**/node_modules/**
**/__pycache__/**
*.py[cod]
